{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@/components/ui/*": ["./registry/ui/*"],
      "@/lib/*": ["./registry/lib/*"]
    }
  },
  "include": ["registry", "preview", "tests", "playwright.config.ts", "vite.config.ts"]
}
